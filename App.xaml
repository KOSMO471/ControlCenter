<Application x:Class="ControlCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackground" Color="#0F0F12"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#16161C"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1D1D26"/>
            <SolidColorBrush x:Key="TextForeground" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="AccentColor" Color="#00D2FF"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#00FF66"/>
            <SolidColorBrush x:Key="WarningColor" Color="#FFAA00"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>