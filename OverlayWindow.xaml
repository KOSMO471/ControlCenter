<Window x:Class="ControlCenter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20">

    <Window.Resources>
        <!-- İkon Buton Stili -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0AB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#2A2A36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metrik Yazı Stili -->
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Ana Overlay Paneli -->
        <Border x:Name="MainBorder"
                Grid.Column="0"
                Background="#E6101015"
                BorderBrush="#2D2D3A"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Width="210"
                MouseEnter="MainBorder_MouseEnter"
                MouseLeave="MainBorder_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.6" ShadowDepth="3"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Daralt / Genişlet Butonu -->
                <Button x:Name="BtnToggle"
                        Grid.Column="0"
                        Style="{StaticResource IconBtn}"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Top"
                        Margin="0,2,6,0"
                        Click="BtnToggle_Click">
                    <Path Data="M 6 4 L 2 8 L 6 12" 
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                          StrokeThickness="2" 
                          Stretch="Uniform" 
                          Width="8" Height="8"/>
                </Button>

                <!-- İçerik Paneli -->
                <StackPanel x:Name="ContentPanel" Grid.Column="1">

                    <!-- Üst Başlık (FPS, Ping ve Ayarlar) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFPS"
                                       Text="FPS 0"
                                       Foreground="#00FF66"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtPing"
                                       Text="0 ms"
                                       Foreground="#00D2FF"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- Ayarlar / Menü Butonu -->
                        <Button x:Name="BtnReopen"
                                Grid.Column="1"
                                Style="{StaticResource IconBtn}"
                                Width="22" Height="22"
                                Click="BtnReopen_Click"
                                PreviewMouseRightButtonDown="BtnReopen_PreviewMouseRightButtonDown">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  Stretch="Uniform" Width="13" Height="13"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Uygulamayı aç" Click="MenuItem_Show_Click"/>
                                    <MenuItem Header="Optimize Et" Click="MenuItem_Optimize_Click"/>
                                    <MenuItem Header="FPS/Ping Göster" IsCheckable="True" IsChecked="True" Click="MenuItem_ToggleFpsPing_Click"/>
                                    <MenuItem Header="Mod Değiştir (Detaylı)" Click="MenuItem_ToggleMode_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Çıkış" Click="MenuItem_Exit_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Ayraç Çizgisi -->
                    <Rectangle Height="1" Fill="#23232E" Margin="0,0,0,6"/>

                    <!-- Donanım Metrikleri Paneli -->
                    <StackPanel x:Name="MetricsPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtCPU" Text="CPU: 0%" Foreground="#00FF66" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtCPUTemp" Text="CPUT: 0°C" Foreground="#FFAA00" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtGPUUsage" Text="GPU: 0%" Foreground="#B866FF" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtGPUTemp" Text="GPUT: 0°C" Foreground="#FFAA00" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TxtRAM" Text="RAM: 0%" Foreground="#00FF66" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtVRAM" Text="VRM: 0MB" Foreground="#B866FF" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtFan" Text="FAN: 0 RPM" Foreground="#00D2FF" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtNet" Text="NET: 0 KB/s" Foreground="#00D2FF" Style="{StaticResource MetricText}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Maskot ve Süre Paneli -->
                    <Border Background="#16161D" CornerRadius="8" Padding="6" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image x:Name="ImgMascot"
                                   Grid.Column="0"
                                   Width="48"
                                   Height="48"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   MouseLeftButtonDown="ImgMascot_MouseLeftButtonDown"
                                   Cursor="Hand"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="OTURUM SÜRESİ" Foreground="#66667A" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtTimer"
                                           Text="00:00:00"
                                           Foreground="#F0F0F0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Başarım Bildirim Paneli (Sağa doğru açılır) -->
        <Border x:Name="AchievementPanel"
                Grid.Column="1"
                Visibility="Collapsed"
                Background="#F0101015"
                BorderBrush="#00FF66"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Width="220">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#00FF66" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🏆 BAŞARIM KAZANILDI"
                           Foreground="#00FF66" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="TxtAchievementTitle"
                           Text=""
                           Foreground="#F0F0F0"
                           FontSize="15"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>